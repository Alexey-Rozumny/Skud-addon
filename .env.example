# Скопируйте в .env и поменяйте значения
POSTGRES_DB=skud
POSTGRES_USER=skud
POSTGRES_PASSWORD=change-me

# Подпись cookie-сессий
SECRET_KEY=change-me-to-random-string

# Первый администратор (создаётся только если таблица admins пуста).
# Если ADMIN_PASSWORD пустой — пароль сгенерируется и будет напечатан в логах.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Ротация истории (дней). 0 — хранить вечно. Можно менять в админке.
EVENTS_RETENTION_DAYS=90

# Сколько секунд без регистрации считать устройство офлайн
DOOR_OFFLINE_SECONDS=120

# Окно подтверждения команды открытия (секунды)
COMMAND_CONFIRM_SECONDS=10

# Время жизни кодовой фразы устройства (секунды)
PHRASE_TTL_SECONDS=86400

# Ставить true только если панель работает за HTTPS
COOKIE_SECURE=false
